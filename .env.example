# PostgreSQL + PostGIS database connection string
DATABASE_URL=

# 32-byte hex secret for signing JWT tokens
JWT_SECRET_KEY=

# Base URL for local/tunneled OSRM instance (optional if using route_cache)
OSRM_BASE_URL=

# Twilio Account SID for SMS alerts (leaves app in MOCK mode if empty)
TWILIO_ACCOUNT_SID=

# Twilio Auth Token for SMS alerts (leaves app in MOCK mode if empty)
TWILIO_AUTH_TOKEN=

# Twilio sender phone number in E.164 format (leaves app in MOCK mode if empty)
TWILIO_FROM_NUMBER=

# Path to Firebase Cloud Messaging service account JSON (leaves push in MOCK mode if empty)
FCM_SERVICE_ACCOUNT_JSON_PATH=

# In-trip check-in window countdown duration in seconds
CHECKIN_WINDOW_SEC=45

# Duration in seconds before an unacknowledged L3 alert escalates to L4
ESCALATION_SUSTAINED_SEC=300

# Minimum cooldown window in seconds between duplicate alert triggers
ALERT_COOLDOWN_SEC=300

# Mapbox access token for custom map rendering (optional)
MAPBOX_ACCESS_TOKEN=

# MinIO access key for audio artifact storage (optional)
MINIO_ACCESS_KEY=

# MinIO secret key for audio artifact storage (optional)
MINIO_SECRET_KEY=

# Groq API Key for STT and Sentiment Analysis via Whisper and Llama3
GROQ_API_KEY=
